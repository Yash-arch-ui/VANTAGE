# ---- backend (backend/) ----
RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Store WITHOUT the 0x prefix — code prepends it.
PRIVATE_KEY=<YOUR_PRIVATE_KEY>
# Optional. Absent -> deterministic template explanations instead of LLM ones.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
DATABASE_PATH=./vantage.db
PORT=4000

# ---- frontend (frontend/) ----
# VITE_* values are inlined at BUILD time — changing them needs a redeploy.
VITE_API_URL=http://localhost:4000
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CHAIN_ID=10143
